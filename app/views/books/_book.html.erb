<div id="<%= dom_id book %>">
  <p>
    <strong>Title:</strong>
    <%= book.title %>
  </p>

  <p>
    <strong>Memo:</strong>
    <%= simple_format(@book.memo) %> <!-- simple_formatメソッドを使って改行を反映 -->
  </p>

  <p>
    <strong>Author:</strong>
    <%= book.author %>
  </p>

  <p>
    <strong>Picture:</strong>
    <%= image_tag(book.picture_url) if book.picture.present? %>
  </p>

</div>
