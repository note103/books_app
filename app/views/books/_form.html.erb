<%= form_with(model: book) do |form| %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
    <% if book.errors.full_messages_for(:title).any? %>
    <ul style="color: red">
      <% book.errors.full_messages_for(:title).each do |message| %>
      <li><%= message %>
      <% end %>
    </ul>
    <% end %>
  </div>

  <div>
    <%= form.label :memo, style: "display: block" %>
    <%= form.textarea :memo %>
    <% if book.errors.full_messages_for(:memo).any? %>
    <ul style="color: red">
      <% book.errors.full_messages_for(:memo).each do |message| %>
      <li><%= message %>
      <% end %>
    </ul>
    <% end %>
  </div>

  <div>
    <%= form.label :author, style: "display: block"  %>
    <%= form.text_field :author %>
  </div>

  <div>
    <%= form.label :picture, style: "display: block" %>
    <%= form.file_field :picture %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
